[flake8]
max-line-length = 88
extend-ignore = E203, E266, E501, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    .tox,
    .pytest_cache,
    *.egg-info
per-file-ignores =
    __init__.py:F401,F403
    tests/*:D100,D101,D102,D103,D104
max-complexity = 10
docstring-convention = google
