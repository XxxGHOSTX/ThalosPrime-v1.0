#!/usr/bin/env python3
"""
Thalos Prime CLI

Command-line interface for managing agent sessions.
Provides commands: start, stop, status, resume, list, etc.
"""

import click
import sys
import json
from pathlib import Path

# Add src to path for imports
sys.path.insert(0, str(Path(__file__).parent.parent / "python"))

from thalos_agent_session import (
    SessionManager,
    SessionPersistence,
    SessionState,
    SyntheticBiologicalIntelligence,
)

# Global instances
manager = SessionManager()
persistence = SessionPersistence()


@click.group()
@click.version_option(version="1.0.0")
def cli():
    """Thalos Prime Agent Session Management CLI"""
    pass


@cli.command()
@click.option("--metadata", "-m", help="Session metadata as JSON")
def start(metadata):
    """Start a new agent session"""
    try:
        metadata_dict = json.loads(metadata) if metadata else {}
        session = manager.create_session(metadata_dict)
        session = manager.start_session(session.session_id)
        persistence.save_session(session)

        click.echo(f"✓ Session started: {session.session_id}")
        click.echo(f"  State: {session.state.value}")
        click.echo(f"  Created: {session.created_at}")
    except Exception as e:
        click.echo(f"✗ Error starting session: {e}", err=True)
        sys.exit(1)


@cli.command()
@click.argument("session_id")
def stop(session_id):
    """Stop (terminate) an agent session"""
    try:
        session = manager.get_session(session_id)
        if not session:
            # Try loading from persistence
            session = persistence.load_session(session_id)
            if session:
                manager.restore_session(session)

        if not session:
            click.echo(f"✗ Session {session_id} not found", err=True)
            sys.exit(1)

        session = manager.terminate_session(session_id)
        persistence.save_session(session)

        click.echo(f"✓ Session stopped: {session_id}")
        click.echo(f"  Final state: {session.state.value}")
    except Exception as e:
        click.echo(f"✗ Error stopping session: {e}", err=True)
        sys.exit(1)


@cli.command()
@click.argument("session_id")
def pause(session_id):
    """Pause a running agent session"""
    try:
        session = manager.get_session(session_id)
        if not session:
            session = persistence.load_session(session_id)
            if session:
                manager.restore_session(session)

        if not session:
            click.echo(f"✗ Session {session_id} not found", err=True)
            sys.exit(1)

        session = manager.pause_session(session_id)
        persistence.save_session(session)

        click.echo(f"✓ Session paused: {session_id}")
        click.echo(f"  State: {session.state.value}")
    except Exception as e:
        click.echo(f"✗ Error pausing session: {e}", err=True)
        sys.exit(1)


@cli.command()
@click.argument("session_id")
def resume(session_id):
    """Resume a paused agent session"""
    try:
        session = manager.get_session(session_id)
        if not session:
            session = persistence.load_session(session_id)
            if session:
                manager.restore_session(session)

        if not session:
            click.echo(f"✗ Session {session_id} not found", err=True)
            sys.exit(1)

        session = manager.resume_session(session_id)
        persistence.save_session(session)

        click.echo(f"✓ Session resumed: {session_id}")
        click.echo(f"  State: {session.state.value}")
    except Exception as e:
        click.echo(f"✗ Error resuming session: {e}", err=True)
        sys.exit(1)


@cli.command()
@click.argument("session_id")
def status(session_id):
    """Get status of an agent session"""
    try:
        # Always load from persistence for most up-to-date state
        session = persistence.load_session(session_id)

        if not session:
            click.echo(f"✗ Session {session_id} not found", err=True)
            sys.exit(1)

        click.echo(f"Session: {session.session_id}")
        click.echo(f"  State: {session.state.value}")
        click.echo(f"  Created: {session.created_at}")
        click.echo(f"  Updated: {session.updated_at}")
        click.echo(f"  Transitions: {session.transition_count}")

        if session.metadata:
            click.echo(f"  Metadata: {json.dumps(session.metadata, indent=4)}")

        if session.state_history:
            click.echo(f"  History:")
            for entry in session.state_history[-5:]:
                click.echo(
                    f"    {entry['from']} → {entry['to']} @ {entry['timestamp']}"
                )
    except Exception as e:
        click.echo(f"✗ Error getting status: {e}", err=True)
        sys.exit(1)


@cli.command()
@click.option("--state", "-s", help="Filter by state")
def list(state):
    """List all agent sessions"""
    try:
        # Load all sessions from persistence
        stored_ids = persistence.list_stored_sessions()
        for session_id in stored_ids:
            session = persistence.load_session(session_id)
            if session and session_id not in manager._sessions:
                manager.restore_session(session)

        state_filter = SessionState(state) if state else None
        sessions = manager.list_sessions(state_filter)

        if not sessions:
            click.echo("No sessions found")
            return

        click.echo(f"Found {len(sessions)} session(s):")
        for session in sessions:
            click.echo(f"  {session.session_id}")
            click.echo(f"    State: {session.state.value}")
            click.echo(f"    Created: {session.created_at}")
    except Exception as e:
        click.echo(f"✗ Error listing sessions: {e}", err=True)
        sys.exit(1)


@cli.command()
def cleanup():
    """Cleanup terminated sessions"""
    try:
        # Load all sessions from persistence
        stored_ids = persistence.list_stored_sessions()
        for session_id in stored_ids:
            session = persistence.load_session(session_id)
            if session and session_id not in manager._sessions:
                manager.restore_session(session)

        # Cleanup from manager
        count = manager.cleanup_terminated_sessions()

        # Also delete terminated session files from persistence
        for session_id in stored_ids:
            session = persistence.load_session(session_id)
            if session and session.state == SessionState.TERMINATED:
                persistence.delete_session(session_id)

        # Cleanup old files
        persistence.cleanup_old_sessions(max_age_days=30)

        click.echo(f"✓ Cleaned up {count} terminated session(s)")
    except Exception as e:
        click.echo(f"✗ Error during cleanup: {e}", err=True)
        sys.exit(1)


@cli.command()
@click.argument("query", nargs=-1, required=False)
@click.option("--interactive", "-i", is_flag=True, help="Enter interactive mode")
def sbi(query, interactive):
    """
    Interact with the SBI (Synthetic Biological Intelligence) interface.
    
    Use natural language to interact with the system. Examples:
    - thalos sbi "create a new session"
    - thalos sbi "what is the system status?"
    - thalos sbi "hello, how are you?"
    - thalos sbi -i  (interactive mode)
    """
    # Initialize SBI
    sbi_interface = SyntheticBiologicalIntelligence(
        session_manager=manager,
        persistence=persistence,
    )
    
    if interactive:
        # Interactive mode
        click.echo("🧠 Thalos Prime SBI Interactive Mode")
        click.echo("=" * 50)
        click.echo("Type your queries in natural language.")
        click.echo("Type 'exit', 'quit', or 'bye' to leave.\n")
        
        while True:
            try:
                user_input = click.prompt("You", type=str, prompt_suffix="> ")
                
                if user_input.lower() in ["exit", "quit", "bye", "q"]:
                    click.echo("\n👋 Goodbye! SBI interface closed.")
                    break
                
                # Process input through SBI
                result = sbi_interface.interpret_and_execute(user_input)
                
                # Display response
                click.echo(f"\n🧠 SBI: {result.get('message', 'Processed.')}")
                
                # Show additional info if available
                if "response" in result:
                    click.echo(f"    {result['response']}")
                
                if result.get("success") and "session_id" in result:
                    click.echo(f"    Session ID: {result['session_id']}")
                
                if "suggestions" in result:
                    click.echo("\n    Suggestions:")
                    for suggestion in result["suggestions"][:3]:
                        click.echo(f"    - {suggestion}")
                
                click.echo()  # Empty line for readability
                
            except KeyboardInterrupt:
                click.echo("\n\n👋 Interrupted. Exiting SBI interface.")
                break
            except EOFError:
                click.echo("\n\n👋 EOF received. Exiting SBI interface.")
                break
    
    elif query:
        # Single query mode
        query_text = " ".join(query)
        
        # Process through SBI
        result = sbi_interface.interpret_and_execute(query_text)
        
        # Display formatted response
        click.echo(f"\n🧠 SBI Response:")
        click.echo(f"   {result.get('message', 'No message')}")
        
        if "response" in result:
            click.echo(f"\n   {result['response']}")
        
        if result.get("success"):
            if "session_id" in result:
                click.echo(f"\n   ✓ Session ID: {result['session_id']}")
                click.echo(f"   ✓ State: {result.get('state', 'unknown')}")
            
            if "sessions" in result:
                click.echo(f"\n   Sessions found: {result['count']}")
                for session in result["sessions"][:5]:
                    click.echo(f"   - {session['session_id']} ({session['state']})")
        
        if "suggestions" in result:
            click.echo("\n   💡 Suggestions:")
            for suggestion in result["suggestions"][:3]:
                click.echo(f"   - {suggestion}")
        
        if not result.get("success", True):
            click.echo(f"\n   ⚠ Note: {result.get('error', 'See message above')}")
    
    else:
        # No query provided - show help
        click.echo("🧠 Thalos Prime SBI Interface\n")
        click.echo("Usage:")
        click.echo("  thalos sbi 'your natural language query'")
        click.echo("  thalos sbi -i  (interactive mode)\n")
        click.echo("Examples:")
        click.echo("  thalos sbi 'create a new session'")
        click.echo("  thalos sbi 'what is the system status?'")
        click.echo("  thalos sbi 'hello, how are you?'")
        click.echo("  thalos sbi 'show me all sessions'")
        click.echo("  thalos sbi 'remember this important data'")


if __name__ == "__main__":
    cli()
